  "dialogue": [
    {
      "id": "cef6b5f3-6050-54bf-a715-e18f410dc821",
      "speaker": "CHAR_MARK",
      "text_hu": "Akkor lehet, hogy csak egy szép kavics.",
      "start": 10,
      "end": 12.115918,
      "audio": "audio/cef6b5f3-6050-54bf-a715-e18f410dc821.mp3",
      "audio_sha256": "de59160e1978bc25e02520068b6f67ac1e92d67f49f5578eabf9adb7c2f247d5",
      "visemes": "audio/cef6b5f3-6050-54bf-a715-e18f410dc821.visemes.json"
    },
    {
      "id": "2386fc17-10d1-5170-95a2-0b36f3ff120a",
      "speaker": "CHAR_LILI",
      "text_hu": "Az én kavicsaim ritkán világítanak.",
      "start": 13.5,
      "end": 15.85102,
      "audio": "audio/2386fc17-10d1-5170-95a2-0b36f3ff120a.mp3",
      "audio_sha256": "7652ff0847e57c4715e452a31fb342348ff4f7c37d2a500d092f3487ae578938",
      "visemes": "audio/2386fc17-10d1-5170-95a2-0b36f3ff120a.visemes.json"
    },
    {
      "id": "f7008600-293c-55a7-90be-29a90764b6e3",
      "speaker": "CHAR_MARK",
      "text_hu": "Nézd! Tetszik neki a kendő.",
      "start": 26,
      "end": 28.037551,
      "audio": "audio/f7008600-293c-55a7-90be-29a90764b6e3.mp3",
      "audio_sha256": "a5124e6616272ded1309b75997f726108babce2a8fe058482b058f67de156edb",
      "visemes": "audio/f7008600-293c-55a7-90be-29a90764b6e3.visemes.json"
    },
    {
      "id": "d1511295-d1f5-529c-b534-8b393bee23b7",
      "speaker": "CHAR_LILI",
      "text_hu": "Fordulj vissza egy kicsit.",
      "start": 38,
      "end": 39.567347,
      "audio": "audio/d1511295-d1f5-529c-b534-8b393bee23b7.mp3",
      "audio_sha256": "e6f6c515d340727f50b985e55b6b58f6ac80dc3641ce7cbea276abe272e38d0f",
      "visemes": "audio/d1511295-d1f5-529c-b534-8b393bee23b7.visemes.json"
    },
    {
      "id": "2f0930b8-161f-5239-abbf-399526e65171",
      "speaker": "CHAR_MARK",
      "text_hu": "Erre akar menni.",
      "start": 45,
      "end": 46.149388,
      "audio": "audio/2f0930b8-161f-5239-abbf-399526e65171.mp3",
      "audio_sha256": "20e4fa1ea45a5654e76d5eb9ce01d8be2ac6cca8d6d2abd83e1913f97829b175",
      "visemes": "audio/2f0930b8-161f-5239-abbf-399526e65171.visemes.json"
    },
    {
      "id": "936df75a-cbdc-58e7-b8fb-9421d2e61981",
      "speaker": "CHAR_MARK",
      "text_hu": "Hiányzik belőle egy rész.",
      "start": 56,
      "end": 57.724082,
      "audio": "audio/936df75a-cbdc-58e7-b8fb-9421d2e61981.mp3",
      "audio_sha256": "fa836e000267b2047b0307bd8ef125ea7d60a3ebac8431b86cf74c6129d70970",
      "visemes": "audio/936df75a-cbdc-58e7-b8fb-9421d2e61981.visemes.json"
    },
    {
      "id": "b6bb4029-79d5-549f-a385-4f9a86280cae",
      "speaker": "CHAR_LILI",
      "text_hu": "Lehet, hogy valamiből ez hiányzik.",
      "start": 60,
      "end": 62.037551,
      "audio": "audio/b6bb4029-79d5-549f-a385-4f9a86280cae.mp3",
      "audio_sha256": "18cedfcc8ccf6b68b7b01e590c83313d5f5cdd1861a6a5c1f01ac204c8296e2b",
      "visemes": "audio/b6bb4029-79d5-549f-a385-4f9a86280cae.visemes.json"
    },
    {
      "id": "25db74df-0d73-592f-82d8-642847187bac",
      "speaker": "CHAR_MARK",
      "text_hu": "Előbb nézzük meg?",
      "start": 66,
      "end": 67.07102,
      "audio": "audio/25db74df-0d73-592f-82d8-642847187bac.mp3",
      "audio_sha256": "b712755a6f41a3c1945ca7d7664f06be0e0d1705604e70dd550dc27c13eab485",
      "visemes": "audio/25db74df-0d73-592f-82d8-642847187bac.visemes.json"
    }
  ],
  "offscreen_dialogue": [
    {
      "id": "225ebeac-c6fb-5641-a488-fede3eb27b90",
      "speaker": "CHAR_LILI",
      "text_hu": "Nem forró. A moha nem száradt ki körülötte.",
      "start": 5,
      "end": 8.395918,
      "audio": "audio/225ebeac-c6fb-5641-a488-fede3eb27b90.mp3",
      "audio_sha256": "4352853c5c02329bf25da78dc81d3bb7644004fa11f55e844e42a9de581a83d9",
      "review_required": true,
      "staging": "offscreen; unresolved take, not approved"
    },
    {
      "id": "7e33345c-135c-5737-b2c2-3fabd3bff89c",
      "speaker": "CHAR_LILI",
      "text_hu": "Vagy valami arra válaszol neki.",
      "start": 48,
      "end": 50.115918,
      "audio": "audio/7e33345c-135c-5737-b2c2-3fabd3bff89c.mp3",
      "audio_sha256": "6ed0c2ef58b354a9acf373b862c10ccec98808308c0911988fdc2f51983b650d",
      "review_required": true,
      "staging": "offscreen; unresolved take, not approved"
    }
