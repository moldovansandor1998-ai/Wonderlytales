  "dialogue": [
    {
      "id": "0b4fdc91-8abb-5fe5-b580-e3df1366c953",
      "speaker": "CHAR_MARK",
      "text_hu": "Hallod? Ropogós az egész erdő.",
      "start": 7,
      "end": 10.004082,
      "audio": "audio/0b4fdc91-8abb-5fe5-b580-e3df1366c953.mp3",
      "audio_sha256": "fb467588f48ffb37da24f49d27cef583d4cdf48c826ade1e4430dab901a7ef29",
      "visemes": "audio/0b4fdc91-8abb-5fe5-b580-e3df1366c953.visemes.json"
    },
    {
      "id": "91110003-0776-5f27-a63e-dae2a57ca5ad",
      "speaker": "CHAR_LILI",
      "text_hu": "Igen. Főleg az a része, amelyiken te mész.",
      "start": 11,
      "end": 13.768979999999999,
      "audio": "audio/91110003-0776-5f27-a63e-dae2a57ca5ad.mp3",
      "audio_sha256": "d48bb349c5151d38792f357ea8716ac9cc61bf07269b15d158e329f3f7229371",
      "visemes": "audio/91110003-0776-5f27-a63e-dae2a57ca5ad.visemes.json"
    },
    {
      "id": "2b64d328-61f2-5379-b56b-0195a2c7b536",
      "speaker": "CHAR_MARK",
      "text_hu": "Ezt nem én csináltam.",
      "start": 17,
      "end": 18.227755,
      "audio": "audio/2b64d328-61f2-5379-b56b-0195a2c7b536.mp3",
      "audio_sha256": "f31062df78c7936b42e7f1cb6555985d7262b6421de89685e8eb56991a0f5eea",
      "visemes": "audio/2b64d328-61f2-5379-b56b-0195a2c7b536.visemes.json"
    },
    {
      "id": "5e163a2b-1ad7-5c05-b46c-78c325f459de",
      "speaker": "CHAR_LILI",
      "text_hu": "A levelet vagy a fényt?",
      "start": 19,
      "end": 20.880816,
      "audio": "audio/5e163a2b-1ad7-5c05-b46c-78c325f459de.mp3",
      "audio_sha256": "9c5482590084a97ccb903479a70b8ae8fe5b8955017a4a7c2d159c88c953af30",
      "visemes": "audio/5e163a2b-1ad7-5c05-b46c-78c325f459de.visemes.json"
    },
    {
      "id": "f6021a21-b5fb-5d83-b867-5a4c3fc193ae",
      "speaker": "CHAR_MARK",
      "text_hu": "Egyiket sem. De a fény érdekel jobban.",
      "start": 22,
      "end": 24.925714,
      "audio": "audio/f6021a21-b5fb-5d83-b867-5a4c3fc193ae.mp3",
      "audio_sha256": "2d28a694273d486e3b4ab1e1214453a266b280446c3bc87c0a7dfa0d85292248",
      "visemes": "audio/f6021a21-b5fb-5d83-b867-5a4c3fc193ae.visemes.json"
    },
    {
      "id": "b0d01e4a-b5d1-5a5c-899d-3c80e82b8865",
      "speaker": "CHAR_LILI",
      "text_hu": "Nem fut el. Mintha jelezne.",
      "start": 31,
      "end": 33.586122,
      "audio": "audio/b0d01e4a-b5d1-5a5c-899d-3c80e82b8865.mp3",
      "audio_sha256": "e16fecc4c6e0517748640e5558f16e471b8db254fc48ddb08e193329c6c2bdae",
      "visemes": "audio/b0d01e4a-b5d1-5a5c-899d-3c80e82b8865.visemes.json"
    },
    {
      "id": "5bc6fc09-9560-502d-a614-2cd62ed757cb",
      "speaker": "CHAR_LILI",
      "text_hu": "Előbb nézzük meg. Aztán nyúlunk hozzá.",
      "start": 42,
      "end": 44.925714,
      "audio": "audio/5bc6fc09-9560-502d-a614-2cd62ed757cb.mp3",
      "audio_sha256": "dcbb7654e5b2b3206a96c4d78cb10d47de3341679c0f4fa1eff7fea8daa385fc",
      "visemes": "audio/5bc6fc09-9560-502d-a614-2cd62ed757cb.visemes.json"
    },
    {
      "id": "c486e74d-7c86-59bd-a8d0-d1e8ec922f6d",
      "speaker": "CHAR_MARK",
      "text_hu": "Szerintem nekünk.",
      "start": 51,
      "end": 51.992653,
      "audio": "audio/c486e74d-7c86-59bd-a8d0-d1e8ec922f6d.mp3",
      "audio_sha256": "e9d0a24358c220ce655a76b457dbf9c39217d205a318fa470fe31170d00d8e45",
      "visemes": "audio/c486e74d-7c86-59bd-a8d0-d1e8ec922f6d.visemes.json"
    }
  ],
