        {
          "kind": "ACTION",
          "direction_hu": "Pötty megérinti a mohát. Elmosolyodik."
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_POTTY",
          "direction": "",
          "text_hu": "Jó. A mohától nem félek. Csak meglepett.",
