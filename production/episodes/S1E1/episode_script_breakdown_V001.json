        },
        {
          "kind": "ACTION",
          "direction_hu": "Bogyó két rövid ugatással körbeszaladja őket. Pötty megsimítja a füle tövét."
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_POTTY",
          "direction": "",
          "text_hu": "Jól van. De ha a kapu köszön, én is köszönök. És aztán gondolkodom.",
          "voice_id": null,
          "recording_status": "RECORDED_DRAFT",
          "recording_id": "3ac5a262-fbc1-5a72-89c5-93b37fbefcff",
