          "recording_status": "RECORDED_DRAFT",
          "recording_id": "3511b9ad-52e2-5666-910c-fa9ceb5e4803",
          "audio_storage_key": "audio/tts/hu/8ik405hgdHADnz9lglMf/af2a78216f96480aa982aa5c.mp3"
        },
        {
          "kind": "ACTION",
          "direction_hu": "Zizi visszafordítja. A mutató a régi tisztásra mutat."
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_ZIZI",
          "direction": "",
          "text_hu": "Van benne egy egyszerű iránytű is. Az nem az én találmányom.",
          "voice_id": null,
          "recording_status": "RECORDED_DRAFT",
          "recording_id": "971cb9b5-361f-5309-a44b-d87c0d7e1256",
