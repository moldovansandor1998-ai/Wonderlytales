        {
          "kind": "DIALOGUE",
          "character": "CHAR_MORZSI",
          "direction": "",
          "text_hu": "Ez a legjobb fajta túra.",
          "voice_id": null,
          "recording_status": "RECORDED_DRAFT",
          "recording_id": "14ccb186-e1eb-5ce3-b03a-a89334d9bf2b",
          "audio_storage_key": "audio/tts/hu/tWNlc7uUtaorMxxrhH9s/923c3f60313cb1d01ac240c6.mp3"
        },
        {
          "kind": "ACTION",
          "direction_hu": "Bogyó megszagolja a kendőt, halk vakkantással hátralép, aztán kíváncsian előre. Pötty óvatosan belenéz."
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_POTTY",
          "direction": "",
          "text_hu": "Ez biztos nem egy villám? A villámok szoktak világítani.",
