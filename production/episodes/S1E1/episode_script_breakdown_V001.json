        {
          "kind": "DIALOGUE",
          "character": "CHAR_MARK",
          "direction": "",
          "text_hu": "Nagyon bátor voltál.",
          "voice_id": null,
          "recording_status": "RECORDED_DRAFT",
          "recording_id": "3c516a6e-20ad-5c70-a370-20c0382b55d5",
          "audio_storage_key": "audio/tts/hu/vmhWRuUG7LqpLLPY9sM1/9c2e94b20ff650df2e4ce570.mp3"
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_POTTY",
          "direction": "",
          "text_hu": "Én közben féltem.",
          "voice_id": null,
          "recording_status": "RECORDED_DRAFT",
