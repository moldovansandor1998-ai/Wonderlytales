          "audio_storage_key": "audio/tts/hu/gvuelryL3NskaN44p9vz/8fe5b254c7705708af947705.mp3"
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_MARK",
          "direction": "",
          "text_hu": "Csak megnézzük, miért arra világít.",
