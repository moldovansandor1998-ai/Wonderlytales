        {
          "kind": "DIALOGUE",
          "character": "CHAR_LILI",
          "direction": "",
          "text_hu": "A villámok nem szoktak kendőben üldögélni.",
          "voice_id": null,
          "recording_status": "RECORDED_DRAFT",
          "recording_id": "5309e767-5148-5c2c-b78b-78fd8bcff5d1",
          "audio_storage_key": "audio/tts/hu/jcrKkDTF93Hvb8jBABwM/ac323411bc84001c85eae77d.mp3"
        },
        {
          "kind": "ACTION",
          "direction_hu": "Zizi a szilánk fölé tartja az eszközét. A mutató egyszer jobbra, egyszer balra ugrik, majd a hátuljára fordul."
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_ZIZI",
          "direction": "",
          "text_hu": "A világ legelső mindenmérője. Most épp azt méri, hogy…",
          "voice_id": null,
          "recording_status": "RECORDED_DRAFT",
          "recording_id": "b21ab5f7-c8d6-5378-a9a4-e5bb316c2866",
          "audio_storage_key": "audio/tts/hu/8ik405hgdHADnz9lglMf/d58989aa2b884264f7da401e.mp3"
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_MORZSI",
          "direction": "",
          "text_hu": "Hogy fejjel lefelé van?",
          "voice_id": null,
          "recording_status": "RECORDED_DRAFT",
          "recording_id": "73956111-1041-505c-9c41-f4fe9b53d960",
          "audio_storage_key": "audio/tts/hu/tWNlc7uUtaorMxxrhH9s/59cc5f6357c83b609a7a0df2.mp3"
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_ZIZI",
          "direction": "",
          "text_hu": "Pontosan. Ezt nagyon pontosan méri.",
