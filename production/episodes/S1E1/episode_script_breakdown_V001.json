          "recording_status": "RECORDED_DRAFT",
          "recording_id": "165ae290-a683-5036-a462-cb44fd4c9d9f",
          "audio_storage_key": "audio/tts/hu/vmhWRuUG7LqpLLPY9sM1/63ddf63b42f2139187e63715.mp3"
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_MORZSI",
          "direction": "",
          "text_hu": "Együtt megyünk. Én viszem a kosarat.",
          "voice_id": null,
          "recording_status": "RECORDED_DRAFT",
          "recording_id": "e2ba4057-2070-539d-abba-804b021f4d92",
