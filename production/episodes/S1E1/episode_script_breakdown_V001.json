        },
        {
          "kind": "ACTION",
          "direction_hu": "Morzsi megtámasztja a könnyű kőfedelet. Zizi felnyit egy külön oldalsó tartót; az nem a kapu része. Márk megtölti Pötty kulacsából a kis földmélyedést, hogy fellazuljon. Pötty nézi a vízmennyiséget, visszakéri a kupakot."
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_POTTY",
          "direction": "",
          "text_hu": "Elég lesz nekünk is?",
          "voice_id": null,
          "recording_status": "RECORDED_DRAFT",
          "recording_id": "a719fa0a-8c3b-56e2-8ad4-f718c6072676",
          "audio_storage_key": "audio/tts/hu/gvuelryL3NskaN44p9vz/c25ab26deab2f021229d611a.mp3"
