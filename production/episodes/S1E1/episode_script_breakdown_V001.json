      "planned_end_sec": 830,
      "planned_duration_sec": 85,
      "location_notes": "Fedett szervizjárat.",
      "beats": [
        {
          "kind": "ACTION",
          "direction_hu": "Pötty első lépése óvatos. A másodiknál a puha moha megcsiklandozza a talpát; hirtelen megáll."
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_POTTY",
          "direction": "",
          "text_hu": "Mi volt ez?",
