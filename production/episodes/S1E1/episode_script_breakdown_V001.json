          "recording_status": "RECORDED_DRAFT",
          "recording_id": "49d1b961-34e2-52e6-a3a7-499348944a3d",
          "audio_storage_key": "audio/tts/hu/gvuelryL3NskaN44p9vz/cea356d7dc639885c6c22680.mp3"
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_ZIZI",
          "direction": "",
          "text_hu": "Attól is elakadhatott a levegő. Ne tépd ki. Megnézzük, hol tud elférni.",
