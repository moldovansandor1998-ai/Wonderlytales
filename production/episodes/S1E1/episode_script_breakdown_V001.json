      "title_hu": "MAKKFALVA BARÁTAI",
      "planned_start_sec": 180,
      "planned_end_sec": 265,
      "planned_duration_sec": 85,
      "location_notes": "Ösvényelágazás, a falu felőli oldal.",
      "beats": [
        {
          "kind": "ACTION",
          "direction_hu": "Morzsi kosárral, Pötty kulaccsal érkezik. Bogyó előttük szaglászik. Zizi egy guruló kis szerkezetet húz; az egyik kerék mindig más irányba akar menni."
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_MORZSI",
          "direction": "",
          "text_hu": "Uzsonnakereső túra?",
          "voice_id": null,
