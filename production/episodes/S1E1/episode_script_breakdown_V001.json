        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_LILI",
          "direction": "",
          "text_hu": "Óvatosan. Ez is ide tartozik.",
          "voice_id": null,
          "recording_status": "RECORDED_DRAFT",
          "recording_id": "36a562ad-6160-5c46-8f22-62fac899c321",
