        {
          "kind": "DIALOGUE",
          "character": "CHAR_MARK",
          "direction": "",
          "text_hu": "Most már csak a három hang.",
          "voice_id": null,
          "recording_status": "RECORDED_DRAFT",
          "recording_id": "3412d83c-0d82-50d9-b7ff-02fd13065e1a",
          "audio_storage_key": "audio/tts/hu/vmhWRuUG7LqpLLPY9sM1/553b9877100fa26f6f59cb0e.mp3"
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_LILI",
          "direction": "",
          "text_hu": "Igen. De ezúttal meghallgatjuk a kertet.",
          "voice_id": null,
          "recording_status": "RECORDED_DRAFT",
          "recording_id": "97a800e1-d55f-52b3-bb7e-8128a65d0451",
          "audio_storage_key": "audio/tts/hu/jcrKkDTF93Hvb8jBABwM/9b8aae163ad2c0b4fcfde3e3.mp3"
        }
      ],
      "director_shot_status": "NOT_YET_BLOCKED_IN_3D"
    },
    {
      "scene_code": "S1E1_SC013",
      "title_hu": "HALLGATNI IS KALAND",
      "planned_start_sec": 905,
      "planned_end_sec": 985,
      "planned_duration_sec": 80,
      "location_notes": "A három fújtató.",
      "beats": [
        {
          "kind": "ACTION",
          "direction_hu": "A csapat leül vagy leguggol. A kapusziget felől a jel halk dallamot ad: mély, magas, középső hang, utána szünet. A szilánk a hátizsák zsebében dereng; Márk újra előveszi a kendőben. A tárgyátadás látható."
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_MARK",
          "direction": "",
          "text_hu": "Ugyanaz a három fény, mint az erdőben.",
          "voice_id": null,
          "recording_status": "RECORDED_DRAFT",
          "recording_id": "aac62198-9652-559d-811a-9bc8547e40c4",
          "audio_storage_key": "audio/tts/hu/vmhWRuUG7LqpLLPY9sM1/7406f7990efb6f55062beeac.mp3"
        },
        {
          "kind": "ACTION",
          "direction_hu": "Zizi a noteszében összehasonlítja a kapunál rajzolt jelekkel. Nem titkos új tudásból találja ki a választ."
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_ZIZI",
          "direction": "",
          "text_hu": "Kör, két pont, hullám. És utána semmi.",
          "voice_id": null,
