        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_MARK",
          "direction": "",
          "text_hu": "Csillagkereső. Az uzsonna még a táskámban van.",
          "voice_id": null,
          "recording_status": "RECORDED_DRAFT",
