          "recording_id": "392a3618-532a-54f7-8a29-577dfe8ef638",
          "audio_storage_key": "audio/tts/hu/vmhWRuUG7LqpLLPY9sM1/89f0e22b817ba60857d91b73.mp3"
        },
        {
          "kind": "ACTION",
          "direction_hu": "Pötty letérdel. A körlap egy kis mélyedésben van; nem veszélyes szerkezet mellett. A nyúl két kézzel megemeli. Alatta keskeny gyökér nő át egy légnyíláson."
        },
        {
          "kind": "DIALOGUE",
          "character": "CHAR_POTTY",
          "direction": "",
          "text_hu": "Megvan! És van itt valami növény is. Bent nőtt a csőben.",
