FROM ubuntu:24.04
ARG BLENDER_VERSION=4.5.3
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl xz-utils python3 python3-venv ffmpeg \
    libgl1 libegl1 libxi6 libxrender1 libxfixes3 libxkbcommon0 libsm6 \
    libxxf86vm1 libxkbcommon-x11-0 libwayland-client0 libwayland-cursor0 \
    libdecor-0-0 libgomp1 libdbus-1-3 \
    xvfb xauth && rm -rf /var/lib/apt/lists/*
# Install the official, checksum-verified Linux binary.
RUN mkdir -p /opt/blender && cd /tmp && \
    curl -fsSLO "https://download.blender.org/release/Blender4.5/blender-${BLENDER_VERSION}-linux-x64.tar.xz" && \
    curl -fsSLO "https://download.blender.org/release/Blender4.5/blender-${BLENDER_VERSION}.sha256" && \
    grep "blender-${BLENDER_VERSION}-linux-x64.tar.xz" "blender-${BLENDER_VERSION}.sha256" | sha256sum -c - && \
    tar -xf "blender-${BLENDER_VERSION}-linux-x64.tar.xz" -C /opt/blender --strip-components=1 && \
    rm "blender-${BLENDER_VERSION}-linux-x64.tar.xz" "blender-${BLENDER_VERSION}.sha256"
RUN python3 -m venv /opt/worker-venv && \
    /opt/worker-venv/bin/pip install --no-cache-dir runpod==1.7.13 boto3==1.35.99
ENV PATH="/opt/worker-venv/bin:/opt/blender:${PATH}"
WORKDIR /worker
# RunPod's GitHub builder uses the repository root as its build context.
COPY worker/blender_worker.py worker/runpod_handler.py worker/storybook_scene.py worker/build_draft_masters.py /worker/
COPY worker/fixtures /worker/fixtures
COPY worker/runpod_start.sh worker/container_smoke.sh /worker/
RUN chmod 755 /worker/runpod_start.sh && blender --background --version && blender --background --python /worker/build_draft_masters.py
RUN apt-get update && apt-get install -y --no-install-recommends tini && rm -rf /var/lib/apt/lists/*
# Xvfb does not send its readiness signal to PID 1. Tini keeps xvfb-run
# as a child process and forwards termination signals to the worker group.
CMD ["/usr/bin/tini", "-g", "--", "/worker/runpod_start.sh"]
